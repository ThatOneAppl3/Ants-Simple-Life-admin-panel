loadstring(game:HttpGet("https://raw.githubusercontent.com/BlueFenster/Public-Scripts-/main/Waypoints%20V1"))()

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer

--// GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ReloadGuiButton"
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = false
ScreenGui.Parent = Player:WaitForChild("PlayerGui")

--// Button
local Button = Instance.new("TextButton")
Button.Name = "ReloadButton"
Button.Parent = ScreenGui
Button.AnchorPoint = Vector2.new(0, 0)
Button.Position = UDim2.new(0.015, 0, 0.08, 0)

-- Responsive sizing
local function updateSize()
	local viewport = workspace.CurrentCamera.ViewportSize
	local size = math.clamp(math.min(viewport.X, viewport.Y) * 0.18, 58, 108)
	Button.Size = UDim2.fromOffset(size, size)
end

updateSize()

workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateSize)

--// Appearance
Button.BackgroundColor3 = Color3.fromRGB(35, 125, 255)
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Text = "Reload gui"
Button.TextScaled = true
Button.Font = Enum.Font.GothamBold
Button.AutoButtonColor = true

-- Make it circular
local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(1, 0)
Corner.Parent = Button

-- Prevent text from getting too cramped
local Padding = Instance.new("UIPadding")
Padding.PaddingLeft = UDim.new(0.12, 0)
Padding.PaddingRight = UDim.new(0.12, 0)
Padding.PaddingTop = UDim.new(0.12, 0)
Padding.PaddingBottom = UDim.new(0.12, 0)
Padding.Parent = Button

--// Click
local clicked = false

Button.MouseButton1Click:Connect(function()
	if clicked then
		return
	end

	clicked = true

	-- Load the GUI
	task.spawn(function()
		loadstring(game:HttpGet(
			"https://raw.githubusercontent.com/ThatOneAppl3/Ants-Simple-Life-admin-panel/refs/heads/main/AdminPanelAnts.lua"
		))()
	end)

	-- Fade everything out
	local fadeInfo = TweenInfo.new(
		0.35,
		Enum.EasingStyle.Quad,
		Enum.EasingDirection.Out
	)

	TweenService:Create(Button, fadeInfo, {
		BackgroundTransparency = 1,
		TextTransparency = 1
	}):Play()

	TweenService:Create(Corner, fadeInfo, {
		-- Corner has no transparency property, so nothing here
	}):Play()

	task.wait(0.4)

	ScreenGui:Destroy()
end)
